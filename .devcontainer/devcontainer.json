{
    "name": "BrewOps",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",
    "features": {
        "ghcr.io/devcontainers/features/node:2": {}
    },
    "postCreateCommand": "pip install --user uv && uv sync",
    "forwardPorts": [8123],
    "customizations": {
        "vscode": {
            "extensions": ["anthropic.claude-code", "GitHub.copilot-chat"]
        }
    }
}
